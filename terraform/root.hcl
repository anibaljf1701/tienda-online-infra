# ─────────────────────────────────────────────────────────────────────────────
# root.hcl
#
# Single source of truth for all stacks. Each stack includes this file via:
#   include "root" { path = find_in_parent_folders("root.hcl") }
#
# find_in_parent_folders("env.hcl") is evaluated in the context of the
# including stack, so it correctly resolves to live/{env}/env.hcl.
#
# WARNING: Targets MiniStack (http://localhost:4566) for LOCAL dev only.
# For real AWS: remove access_key, secret_key, skip_* flags, endpoint,
# and force_path_style. Use IAM roles or env vars instead.
# ─────────────────────────────────────────────────────────────────────────────

locals {
  # Resolved in the context of the including stack — finds live/{env}/env.hcl
  env_vars    = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  environment = local.env_vars.locals.environment

  project = "tienda"
  region  = "us-east-1"
}

# ── Remote state ──────────────────────────────────────────────────────────────
remote_state {
  backend = "s3"

  config = {
    bucket  = "tienda-tfstate"
    key     = "${path_relative_to_include()}/terraform.tfstate"
    region  = local.region
    encrypt = true

    # MiniStack endpoint — remove for real AWS
    endpoint                    = "http://localhost:4566"
    access_key                  = "test"
    secret_key                  = "test"
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_requesting_account_id  = true
    force_path_style            = true
  }

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }
}

# ── Provider generation ───────────────────────────────────────────────────────
generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"

  contents = <<-EOF
    # AUTO-GENERATED by Terragrunt — do not edit manually.
    # WARNING: MiniStack config for LOCAL development only.
    # Remove access_key, secret_key, skip_* flags, and the endpoints block
    # before deploying to a real AWS environment.

    provider "aws" {
      region     = "${local.region}"
      access_key = "test"
      secret_key = "test"

      skip_credentials_validation = true
      skip_metadata_api_check     = true
      skip_requesting_account_id  = true

      default_tags {
        tags = {
          Project     = "${local.project}"
          Environment = "${local.environment}"
          ManagedBy   = "Terraform"
        }
      }

      endpoints {
        s3             = "http://localhost:4566"
        sqs            = "http://localhost:4566"
        sns            = "http://localhost:4566"
        dynamodb       = "http://localhost:4566"
        iam            = "http://localhost:4566"
        sts            = "http://localhost:4566"
        secretsmanager = "http://localhost:4566"
        ssm            = "http://localhost:4566"
        cloudwatchlogs = "http://localhost:4566"
        lambda         = "http://localhost:4566"
      }
    }
  EOF
}

# ── Global inputs ─────────────────────────────────────────────────────────────
inputs = {
  project     = local.project
  environment = local.environment
  region      = local.region
}
