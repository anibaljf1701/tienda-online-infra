<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${project} - Product Catalog</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f4f6f9;
      color: #333;
      min-height: 100vh;
    }

    header {
      background-color: #1a1a2e;
      color: #fff;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .env-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #fff;
    }

    .env-badge-dev  { background-color: #27ae60; }
    .env-badge-prod { background-color: #c0392b; }

    main {
      max-width: 1100px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }

    main h2 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      color: #555;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.25rem;
    }

    .product-card {
      background-color: #fff;
      border-radius: 10px;
      padding: 1.25rem;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .product-name {
      font-size: 1rem;
      font-weight: 600;
      color: #1a1a2e;
    }

    .product-price {
      font-size: 1.2rem;
      font-weight: 700;
      color: #2c3e50;
    }

    .stock-badge {
      display: inline-block;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      width: fit-content;
    }

    .stock-in_stock     { background-color: #d4edda; color: #155724; }
    .stock-low_stock    { background-color: #fff3cd; color: #856404; }
    .stock-out_of_stock { background-color: #f8d7da; color: #721c24; }

    footer {
      text-align: center;
      padding: 2rem;
      color: #999;
      font-size: 0.82rem;
    }
  </style>
</head>
<body>

  <header>
    <h1>${project}</h1>
    <span class="env-badge env-badge-${environment}">${environment}</span>
  </header>

  <main>
    <h2>Product Catalog</h2>
    <div class="product-grid">
      %{ for product in products ~}
      <div class="product-card">
        <span class="product-name">${product.name}</span>
        <span class="product-price">&#36;${format("%.2f", product.price)}</span>
        <span class="stock-badge stock-${product.stock == 0 ? "out_of_stock" : product.stock <= 5 ? "low_stock" : "in_stock"}">${product.stock == 0 ? "Out of Stock" : product.stock <= 5 ? "Low Stock" : "In Stock"} (${product.stock})</span>
      </div>
      %{ endfor ~}
    </div>
  </main>

  <footer>
    &copy; ${project} &mdash; Environment: ${environment}
  </footer>

</body>
</html>
